<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZaruPass.Program.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ZaruPass.Program.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ZaruPass.Program.Views.AuthorizationWindow"
        Title="AuthorizationWindow"
        x:DataType="vm:AuthorizationWindowViewModel">
        
    <Window.DataContext>
        <vm:AuthorizationWindowViewModel />
    </Window.DataContext>

    <Grid Margin="10">
		<views:LoginingView IsVisible="{Binding IsPinCodeVisible}"/>
        <TextBlock></TextBlock>
    </Grid>
</Window>
