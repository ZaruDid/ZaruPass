<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:ZaruPass.Program.ViewModels"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="ZaruPass.Program.Views.LoginingView"
            x:DataType="vm:LoginingViewModel">

    <UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
			<Setter Property="VerticalAlignment" Value="Stretch"></Setter>
			<Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
			<Setter Property="VerticalContentAlignment" Value="Center"></Setter>
			<Setter Property="FontSize" Value="50"></Setter>
			<Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
    </UserControl.Styles>

        
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="0.3*"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
			<RowDefinition Height="0.2*"></RowDefinition>
		</Grid.RowDefinitions>
		<Label VerticalContentAlignment="Center"
			   HorizontalContentAlignment="Center"
			   FontWeight="Bold"
			   FontSize="40"
			   Content="{Binding PinCodeStars}"></Label>
		<UniformGrid Grid.Row="1" Columns="3" Rows="4">
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="1">1</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="2">2</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="3">3</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="4">4</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="5">5</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="6">6</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="7">7</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="8">8</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="9">9</Button>
			<Button Command="{Binding AddSymbolCommand}"
					CommandParameter="0">0</Button>
			<Button Command="{Binding RemoveSymbolCommand}">&lt;</Button>
			<Button Command="{Binding ClearPinCodeCommand}">ce</Button>
		</UniformGrid>
		<Button Command="{Binding ForwardCommand}" Grid.Row="2" FontSize="20">Далее</Button>
    </Grid>
</UserControl>
